{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxlint-config/refs/heads/main/schema.json",
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "warn",
    "eqeqeq": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "packages/docs/build/**",
    "packages/docs/.react-router/**",
    "packages/docs/.source/**"
  ]
}
