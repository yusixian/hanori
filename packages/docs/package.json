  "dependencies": {
    "@react-router/node": "7.13.0",
    "fumadocs-core": "^16.15.11",
    "fumadocs-mdx": "^15.4.1",
    "fumadocs-ui": "^16.15.11",
    "isbot": "^5",
    "lucide-react": "^1.24.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "7.13.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.13.0",
    "@tailwindcss/vite": "^4",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.3.1"
  }
