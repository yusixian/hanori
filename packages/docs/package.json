{
  "name": "@cos-tool-bot/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:release": "node scripts/sync-release.mjs",
    "dev": "pnpm sync:release && react-router dev --port ${COS_TOOL_BOT_DEV_DOCS_PORT:-43102} --strictPort",
