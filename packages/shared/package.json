{
  "name": "@cos-tool-bot/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./file-validation": {
      "types": "./src/file-validation.ts",
      "browser": null,
      "development": "./src/file-validation.ts",
      "default": "./dist/file-validation.js"
    },
    "./file-reader": {
      "types": "./src/file-reader.ts",
      "browser": null,
      "development": "./src/file-reader.ts",
      "default": "./dist/file-reader.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/file-validation.ts src/file-reader.ts --format esm --no-dts --sourcemap && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.9.3"
  }
}
