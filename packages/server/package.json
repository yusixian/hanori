{
  "name": "@cos-tool-bot/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "PORT=3000 tsx --conditions=development --env-file=../../.env --watch src/index.ts",
    "build": "tsdown src/index.ts --format esm",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.35",
    "@ai-sdk/openai-compatible": "^2.0.0",
    "@aws-sdk/client-s3": "^3.995.0",
    "@cos-tool-bot/bot": "workspace:*",
    "@cos-tool-bot/database": "workspace:*",
    "@cos-tool-bot/shared": "workspace:*",
    "@hono/node-server": "^1.14.1",
    "@hono/zod-validator": "^0.7.6",
    "ai": "^6.0.0",
    "archiver": "^7.0.1",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.5",
    "jose": "^6.0.8",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "superjson": "^2.2.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "tsdown": "^0.9.3"
  }
}
