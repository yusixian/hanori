{
  "name": "@cos-tool-bot/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx --env-file=../../.env --watch src/index.ts",
    "build": "tsdown src/index.ts --format esm",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cos-tool-bot/bot": "workspace:*",
    "@cos-tool-bot/database": "workspace:*",
    "@cos-tool-bot/shared": "workspace:*",
    "@hono/node-server": "^1.14.1",
    "@hono/zod-validator": "^0.7.6",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.5",
    "jose": "^6.0.8",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsdown": "^0.9.3"
  }
}
