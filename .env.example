# Full environment reference. For manual Docker setup, start with .env.selfhost.example.

# --- Production requirements ---
# Docker Compose builds DATABASE_URL from DB_PASSWORD. For a new instance,
# generate a URL-safe password with: openssl rand -hex 32
DB_PASSWORD=password
# Generate an independent authentication secret of at least 32 characters.
BETTER_AUTH_SECRET=change-me-to-a-random-secret-at-least-32-characters
# Use your public HTTPS origin in production. HTTP is for local loopback only.
BETTER_AUTH_URL=http://localhost:43100
AUTH_OWNER_EMAIL=owner@example.com
# Required in every environment. Keep the existing value when upgrading or restoring.
# For a NEW instance only, generate independently with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- First-time initialization ---
# Used only to bootstrap the first owner. Set a random password and remove it after first login.
PANEL_PASSWORD=change-me
# Optional Telegram Bot settings (migrated to DB on first run).
BOT_TOKEN=
ADMIN_CHAT_IDS=[]

# --- Optional integrations and deployment settings ---
# Optional until the Telegram Mini App is enabled. Generate independently from
# BETTER_AUTH_SECRET with: openssl rand -hex 32
MINI_APP_SESSION_SECRET=
# Optional Google OAuth credentials. Callback: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional GitHub App used by administrators to authorize repository access.
# Configure all five values or leave all five empty. GitHub App registration:
# Homepage ${BETTER_AUTH_URL}; Setup ${BETTER_AUTH_URL}/api/github-app/setup;
# Callback ${BETTER_AUTH_URL}/api/github-app/callback. Do not enable OAuth during installation.
# See docs/GITHUB_APP.md.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Paste the PEM as one unquoted or single-quoted line with literal \n separators.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=

# Embedding dimensions (optional, default 3072; must match the database schema)
# Changing after deployment requires regenerating migrations + reindexing
EMBEDDING_DIMENSIONS=3072

# Log Cleanup (optional)
RUNTIME_DIAGNOSTIC_RETENTION_MS=86400000
LOG_RETENTION_DAYS=30
LOG_RETENTION_DAYS_ERROR=90
LOG_CLEANUP_INTERVAL_HOURS=24
GENERATION_RETENTION_DAYS=30

# Direct Docker Compose host port (also used by the local Node.js server).
PORT=43100
# Every full Compose deployment runs the verified database backup gate.
# Optional profiles: coding for Pi, media for audio conversion, nsfw for image classification; combine as coding,media.
COMPOSE_PROFILES=
# Optional reproducibility overrides. Keep the defaults for initial setup, then
# pin production digests after verifying they support the server architecture.
POSTGRES_IMAGE=pgvector/pgvector:pg17
NSFW_API_IMAGE=ghcr.io/arnidan/nsfw-api:latest
# Optional 40-character Git SHA override for source archives without .git metadata.
# Normal Git/Dokploy builds derive this automatically and should leave it empty.
APP_VERSION=
# Optional public HTTPS origin for documentation SEO (build-time; rebuild after changes).
# Empty omits canonical/social URLs and sitemap entries; never include /docs here.
DOCS_SITE_URL=

# Optional Pi coding worker. Required when COMPOSE_PROFILES=coding.
# Generate with: openssl rand -hex 32
CODING_WORKER_SECRET=
# Worker connection and storage overrides for source deployments. Compose sets its own paths.
CODING_WORKER_SOCKET=
CODING_JOB_DIR=./data/coding-job
CODING_WORKSPACES_DIR=./data/code-workspaces
CODING_GIT_DIR=./data/code-git
# Set only when the worker runs as a different OS user (Docker uses 1000).
# CODING_WORKSPACE_UID=1000
# CODING_WORKSPACE_GID=1000
# Legacy image MCP endpoints, used only until a platform address is saved in the panel.
# New installations: configure one domain under Usage & image governance > Image MCP platform.
# Existing HTTPS URLs remain supported; HTTP loopback is development-only.
PIXAI_MCP_URL=

# Trusted plugin artifacts persist under this directory (Compose uses /app/data/plugins).
PLUGIN_DIRECTORY=./data/plugins
# Optional isolated audio converter. Set COMPOSE_PROFILES=media (or coding,media)
# and generate a dedicated secret with openssl rand -hex 32.
# Accepts 32..256 ASCII letters, digits, and /+_=-; no spaces or newlines.
# Cookie, ASR endpoint/model/key/consent and budgets are configured in the web plugin page.
MEDIA_WORKER_SECRET=
MEDIA_WORKER_SOCKET=
MEDIA_JOB_DIR=./data/media-jobs
MEDIA_WORKER_GID=1000
# Legacy fallback; the saved panel platform address overrides all three endpoints.
OPENAI_IMAGE_MCP_URL=
GEMINI_IMAGE_MCP_URL=

# Dokploy upgrades: set this to the network already shared by Traefik and app.
TRAEFIK_DOCKER_NETWORK=dokploy-network

# --- Local development only ---
DATABASE_URL=postgresql://bot:password@localhost:43105/cos_tool_bot
# Start nsfw-api from docker-compose.dev.yml. In production Compose, use
# http://nsfw-api:3000 or omit the override to use the Compose default.
NSFW_API_URL=http://localhost:43106
CODING_WORKER_URL=http://localhost:3010
# Local Mini App tunnel HTTPS origin (required for pnpm dev:mini-app).
COS_TOOL_BOT_MINI_APP_ORIGIN=
