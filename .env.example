# Database
DATABASE_URL=postgresql://bot:password@localhost:5432/cos_tool_bot

# Telegram Bot (optional - migrated to DB on first run)
BOT_TOKEN=
ADMIN_CHAT_IDS=[]

# Encryption (optional - has built-in default, override for production)
ENCRYPTION_KEY=

# Panel Auth
JWT_SECRET=change-me-to-a-random-string
PANEL_PASSWORD=change-me

# Embedding dimensions (optional, default 1536)
# Changing after deployment requires regenerating migrations + reindexing
EMBEDDING_DIMENSIONS=1536

# S3 Backup (optional)
ENABLE_S3_BACKUP=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_REGION=auto
S3_PUBLIC_URL=https://xxx.xxxx.com
BACKUP_FILE_PREFIX="backup/tg-bot-backup/cos-tg-bot-"

# Log Cleanup (optional)
LOG_RETENTION_DAYS=30
LOG_RETENTION_DAYS_ERROR=90
LOG_CLEANUP_INTERVAL_HOURS=24

# Docker Compose
DB_PASSWORD=password
PORT=3000
