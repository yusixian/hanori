# For manual setup, copy to .env, set mode 0600, and run pnpm deploy:env:check.

# --- Production requirements ---
# Generate independent values for DB_PASSWORD, BETTER_AUTH_SECRET, and ENCRYPTION_KEY
# with openssl rand -hex 32. Keep DB_PASSWORD and ENCRYPTION_KEY on upgrades.
DB_PASSWORD=
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
# Public HTTPS origin, without a path. For a local trial, use http://localhost:43100.
BETTER_AUTH_URL=
AUTH_OWNER_EMAIL=

# --- First-time initialization ---
# Generate a random password for the first owner login, then remove this setting.
PANEL_PASSWORD=

# --- Optional settings ---
# Generate with openssl rand -hex 32 to use a separate Mini App session secret.
MINI_APP_SESSION_SECRET=
BOT_TOKEN=
ADMIN_CHAT_IDS=

# Host port for direct and prebuilt Compose. Match the port in a local HTTP origin.
PORT=43100
