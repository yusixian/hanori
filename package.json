{
  "name": "cos-tool-bot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A grammy Telegram bot with Hono API and Vue panel",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @cos-tool-bot/server dev\" \"pnpm --filter @cos-tool-bot/panel dev\"",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @cos-tool-bot/database generate",
    "db:migrate": "pnpm --filter @cos-tool-bot/database migrate",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "lint": "oxlint .",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "concurrently": "^9.1.2",
    "oxlint": "^0.15.7",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "rolldown",
      "@tailwindcss/oxide"
    ]
  }
}
