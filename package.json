{
  "name": "cos-tool-bot",
  "version": "0.2.0",
  "private": true,
  "description": "A grammy Telegram bot with Hono API and Vue panel",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @cos-tool-bot/server dev\" \"pnpm --filter @cos-tool-bot/panel dev\"",
    "dev:db": "docker compose -p cos-bot-dev -f docker-compose.dev.yml up -d",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @cos-tool-bot/database generate",
    "db:migrate": "pnpm --filter @cos-tool-bot/database migrate",
    "docker:up": "docker compose -p cos-bot-prod up -d --build",
    "docker:rebuild": "docker compose -p cos-bot-prod build --no-cache && docker compose -p cos-bot-prod up -d",
    "docker:down": "docker compose -p cos-bot-prod down",
    "docker:logs": "docker compose -p cos-bot-prod logs -f app",
    "docker:prune": "docker image prune -f",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint .",
    "typecheck": "tsc -b",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "concurrently": "^9.1.2",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.34.0",
    "oxlint": "^0.15.7",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint",
      "oxfmt --check"
    ],
    "*.json !**/drizzle/**": [
      "oxfmt --check"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.5.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "rolldown",
      "simple-git-hooks",
      "@tailwindcss/oxide"
    ]
  }
}
