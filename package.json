{
  "name": "cos-tool-bot",
  "version": "0.15.0",
  "private": true,
  "description": "A grammy Telegram bot with Hono API and Vue panel",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @cos-tool-bot/server dev\" \"pnpm --filter @cos-tool-bot/panel dev\" \"pnpm dev:docs\"",
    "dev:docs": "pnpm --filter @cos-tool-bot/docs dev",
    "build:docs": "pnpm --filter @cos-tool-bot/docs build",
    "preview:docs": "tsx packages/server/scripts/preview-public-docs.ts",
    "test:docs": "playwright test --config acceptance/docs.config.ts",
    "dev:mini-app": "bash scripts/dev-mini-app.sh start",
    "dev:mini-app:stop": "bash scripts/dev-mini-app.sh stop",
    "dev:mini-app:status": "bash scripts/dev-mini-app.sh status",
    "dev:coding-worker": "pnpm --filter @cos-tool-bot/coding-worker dev",
    "dev:db": "docker compose -p cos-bot-dev -f docker-compose.dev.yml up -d",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @cos-tool-bot/database generate",
    "db:migrate": "pnpm --filter @cos-tool-bot/database migrate",
    "docker:up": "docker compose -p cos-bot-prod -f docker-compose.yml -f docker-compose.direct.yml up -d --build",
    "docker:rebuild": "docker compose -p cos-bot-prod -f docker-compose.yml -f docker-compose.direct.yml build --no-cache && docker compose -p cos-bot-prod -f docker-compose.yml -f docker-compose.direct.yml up -d",
    "docker:down": "docker compose -p cos-bot-prod -f docker-compose.yml -f docker-compose.direct.yml down",
    "docker:logs": "docker compose -p cos-bot-prod -f docker-compose.yml -f docker-compose.direct.yml logs -f app",
    "docker:prune": "docker image prune -f",
    "deploy:dokploy:check": "node scripts/check-dokploy-compose.mjs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint .",
    "typecheck": "tsc -b && pnpm --filter @cos-tool-bot/docs typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:browser": "pnpm --filter @cos-tool-bot/panel test:browser",
    "i18n:check": "tsx packages/panel/scripts/check-i18n.ts",
    "acceptance": "node acceptance/scripts/run.mjs",
    "acceptance:report": "node acceptance/scripts/report.mjs",
    "acceptance:open": "node acceptance/scripts/open.mjs",
    "acceptance:clean": "node acceptance/scripts/clean.mjs",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^4.0.0",
    "concurrently": "^9.1.2",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.34.0",
    "oxlint": "^0.15.7",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint",
      "oxfmt --check"
    ],
    "*.json !**/drizzle/**": [
      "oxfmt --check"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.5.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "rolldown",
      "simple-git-hooks",
      "@tailwindcss/oxide"
    ]
  }
}
